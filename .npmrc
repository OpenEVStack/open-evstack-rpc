# Set the registry for this project (e.g., npmjs.org or a custom registry)
registry=https://registry.npmjs.org/

# If using a private registry or enterprise, add your auth token (npm login will do this automatically)
//registry.npmjs.org/:_authToken=${NPM_TOKEN}
//npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}
# Save exact version dependencies (default is ^)
save-exact=true

# Specify default package scope (e.g., @openevstack for your packages)
scope=@openevstack

# Set a custom cache directory if needed
cache=~/.npm-cache
