{
  "compilerOptions": {
    "target": "ES2019",                         // Modern JS output
    "module": "CommonJS",                       // Compatible with Node.js
    "declaration": true,                        // Generates .d.ts files for npm packages
    "outDir": "dist",                           // Output folder for compiled JS
    "rootDir": "src",                           // Source files live here
    "strict": true,                             // Enables strict type checking
    "esModuleInterop": true,                    // For importing commonjs modules
    "forceConsistentCasingInFileNames": true,   // Avoids case-related bugs
    "skipLibCheck": true                        // Speeds up build time
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
